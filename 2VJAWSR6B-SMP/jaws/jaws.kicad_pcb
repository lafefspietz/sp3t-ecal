	)
	(gr_text_box "Contact Info:\nAnna Fox\n303-497-5984\nfoxa@nist.gov"
		(start 171.17695 110.601015)
		(end 189.96703 120.453785)
		(margins 0 0 0 0)
		(layer "User.1")
		(uuid "e7fc3bf7-4090-4eb4-a051-fe79f231487f")
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.254)
			)
			(justify left top)
		)
		(border no)
		(stroke
			(width 0.1)
			(type default)
		)
	)
	(gr_text_box "A)  using 10/31/10 mil gcpw (using Rogers 4350B 0.508mm, like in J7/J8 of “Rogers 4350b 20 mil test board, rev 3.0”)\nB)  Launch to smp use 47mil hole (like in J7/J8 of “Rogers 4350b 20 mil test board, rev 3.0”)\nC)  Keep wide pin launch (like in J7/J8 of “Rogers 4350b 20 mil test board, rev 3.0”)\nthen remove more grnd around the pin on the back of the PCB (see picture).  This does assume that the hole in the copper package will be larger than the removed grnd plane\nD)  If we are going to be doing assembly, then reduce exposed area of top paste (maybe even if other people are doing assembly); with the current top-paste mask, I am getting too much solder paste \nE)  reduce size of the smp mounting holes slightly\nF) backside fully covered in copper ground plane with no mask?"
		(start 167.93845 46.825535)
		(end 474.36405 70.923785)
		(margins 0 0 0 0)
		(layer "User.2")
		(uuid "bf16ec0b-60de-48fe-b43e-cb3e778c994e")
