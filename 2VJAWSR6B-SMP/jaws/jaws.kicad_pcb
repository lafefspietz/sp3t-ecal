	(gr_text_box "2 Layers\nRO4350b 20 mil stack up\nFinished thickness  0.508 mm\n1oz copper outer layer\nSoldermask top: green\nSoldermask bottom: green\nSilkscreen: white\nFinish: Immersion Au\nMolex SMP 0734153310\n"
		(start 170.2054 75.065195)
		(end 260.9215 105.029635)
		(margins 0 0 0 0)
		(layer "User.1")
		(uuid "e792c0f3-c68c-4420-8412-b78e00f24d3c")
